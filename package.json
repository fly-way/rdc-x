{
  "name": "rdc-x",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local-first Windows computer MCP server for ChatGPT with files, terminal, desktop, documents, Unity and Secure MCP Tunnel",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && node --check public/app.js && node --check scripts/dashboard.mjs && node --check scripts/launch.mjs && node --check scripts/doctor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "drill": "tsx scripts/live-drill.ts",
    "drill:desktop": "tsx scripts/desktop-drill.ts",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "mime-types": "^3.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
